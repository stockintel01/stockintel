rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// StockIntel — Firestore Security Rules
//
// Role hierarchy: super_admin > owner > manager > worker
// Approved super admin accounts have full read/write.
// All other access is org-scoped and role-gated.
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'mawuklegodson@gmail.com',
          'enochapafloe@gmail.com',
          'stockintel01@gmail.com'
        ];
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function orgId() {
      return userDoc().organizationId;
    }

    function isOwner()   { return role() == 'owner';   }
    function isManager() { return role() == 'manager'; }
    function isWorker()  { return role() == 'worker';  }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function isSameOrg(resourceOrgId) {
      return orgId() == resourceOrgId;
    }

    function hasActiveSubscription(resourceOrgId) {
      let subscription = get(/databases/$(database)/documents/organizations/$(resourceOrgId)).data.subscription;
      return isSuperAdmin() || (
        subscription.status == 'active' &&
        (
          (subscription.plan == 'free_trial' && subscription.trialEndsAt > request.time) ||
          (subscription.plan != 'free_trial' && (!('currentPeriodEnd' in subscription) || subscription.currentPeriodEnd > request.time))
        )
      );
    }

    // ── Super Admin — full access to everything ──────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── System config (read-only for all signed-in users) ────────
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Global patients collection (cross-pharmacy) ──────────────
    match /patients/{patientId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isSameOrg(resource.data.organizationId) && isOwnerOrManager())
      );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'owner'
        && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Organisations ────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSameOrg(orgId) || isSuperAdmin());
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.subscription.plan == 'free_trial'
        && request.resource.data.subscription.status == 'active';
      allow update: if isSignedIn() && (
        (isSameOrg(orgId) && isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name', 'industry', 'currency', 'address', 'phone', 'taxId',
              'onboardingStep', 'onboardingComplete', 'receiptSettings', 'settings', 'updatedAt'
            ])) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      // ── Inventory ─────────────────────────────────────────────
      match /inventory/{itemId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && isOwnerOrManager()
          && request.resource.data.keys().hasAll(['name', 'sku', 'quantity', 'mrp', 'costPrice'])
          && request.resource.data.quantity >= 0
          && request.resource.data.mrp >= 0;
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && (
            isOwnerOrManager() ||
            (isWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']))
          )
          && (!request.resource.data.keys().hasAll(['quantity']) || request.resource.data.quantity >= 0);
        allow delete: if isSuperAdmin();
      }

      // ── Prescriptions ─────────────────────────────────────────
      match /prescriptions/{rxId} {
        allow read, write: if isSignedIn() && isSameOrg(orgId);
      }

      // ── Customers ─────────────────────────────────────────────
      match /customers/{custId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      // ── Sales ─────────────────────────────────────────────────
      match /sales/{saleId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /locations/{locationId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /transfers/{transferId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /shifts/{shiftId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      // ── Consultations ─────────────────────────────────────────
      match /consultations/{cId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
      }

      match /patients/{patientId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager();
      }

      // ── Credits / Rewards ──────────────────────────────────────
      match /credits/{creditId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSuperAdmin();
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      // ── Agric collections ──────────────────────────────────────
      // Expense intelligence
      match /expense_categories/{categoryId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      match /expense_budgets/{budgetId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      match /expenses/{expenseId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && request.resource.data.submittedById == request.auth.uid
          && request.resource.data.amount > 0
          && (isOwnerOrManager() || request.resource.data.status == 'pending');
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && isOwnerOrManager()
          && request.resource.data.amount > 0
          && request.resource.data.submittedById == resource.data.submittedById;
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      match /agric_inventory/{id}   { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_usage/{id}       { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_requests/{id}    { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_equipment/{id}   { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_plans/{id}       { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_packing/{id}     { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_shipping/{id}    { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_adjustments/{id} { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_alerts/{id}      { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_deletion_log/{id}{ allow read: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager(); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_livestock/{id}   { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
      match /agric_crop_plans/{id}  { allow read: if isSignedIn() && isSameOrg(orgId); allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId); }
    }

    // ── Invitations ──────────────────────────────────────────────
    match /invitations/{inviteId} {
      allow create: if false;
      allow read: if isSignedIn() && isSameOrg(resource.data.organizationId);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── Default deny (overridden by super admin catch-all above) ─
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
