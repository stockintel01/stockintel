rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// StockIntel — Firestore Security Rules
//
// Role hierarchy: super_admin > owner > manager > worker
// Approved super admin accounts have full read/write.
// All other access is org-scoped and role-gated.
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'mawuklegodson@gmail.com',
          'enochapafloe@gmail.com',
          'stockintel01@gmail.com'
        ];
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function orgId() {
      return userDoc().organizationId;
    }

    function isOwner()   { return role() == 'owner';   }
    function isManager() { return role() == 'manager'; }
    function isWorker()  { return role() == 'worker';  }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function workerAssignableAccess() {
      return [
        'dashboard', 'expenses', 'agricStock', 'agricRequests', 'agricUsage',
        'agricPlanner', 'agricEquipment', 'agricPacking', 'agricReports',
        'agricWeather', 'agricLivestock', 'agricCrops', 'agricSigatoka'
      ];
    }

    function managerAssignableAccess() {
      return [
        'dashboard', 'expenses', 'team', 'settings', 'agricStock',
        'agricRequests', 'agricUsage', 'agricPlanner', 'agricEquipment',
        'agricPacking', 'agricReports', 'agricWeather', 'agricLivestock',
        'agricCrops', 'agricSigatoka'
      ];
    }

    function validRoleAccess(data) {
      return data.keys().hasAll(['role', 'access'])
        && data.access is list
        && (
          (data.role == 'worker' && data.access.hasOnly(workerAssignableAccess())) ||
          (data.role == 'manager' && data.access.hasOnly(managerAssignableAccess()))
        );
    }

    function canDelegateRoleAccess(data) {
      let delegatorAccess = userDoc().keys().hasAny(['access'])
        ? userDoc().access
        : managerAssignableAccess();
      return validRoleAccess(data) && (
        isOwner() ||
        (isManager() && data.access.hasOnly(delegatorAccess))
      );
    }

    function hasAccess(key) {
      return isSuperAdmin() || isOwner() ||
        (isManager() && !userDoc().keys().hasAny(['access']) && managerAssignableAccess().hasAny([key])) ||
        (userDoc().keys().hasAny(['access']) && userDoc().access.hasAny([key]));
    }

    function canFulfillStockRequests() {
      return isOwnerOrManager() || (hasAccess('agricRequests') && hasAccess('agricStock'));
    }

    function isSameOrg(resourceOrgId) {
      return orgId() == resourceOrgId;
    }

    function invitationDoc(inviteId) {
      return get(/databases/$(database)/documents/invitations/$(inviteId)).data;
    }

    function isValidInvitationProfileWrite(userId) {
      let invite = invitationDoc(request.resource.data.acceptedInviteId);
      return request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.organizationId == invite.organizationId
        && request.resource.data.role == invite.role
        && request.resource.data.access == invite.access
        && invite.email == request.auth.token.email
        && invite.status == 'pending';
    }

    function hasActiveSubscription(resourceOrgId) {
      let subscription = get(/databases/$(database)/documents/organizations/$(resourceOrgId)).data.subscription;
      return isSuperAdmin() || (
        subscription.status == 'active' &&
        (
          (subscription.plan == 'free_trial' && subscription.trialEndsAt > request.time) ||
          (subscription.plan != 'free_trial' && (!('currentPeriodEnd' in subscription) || subscription.currentPeriodEnd > request.time))
        )
      );
    }

    function validPackingQualityState(data) {
      return !data.keys().hasAny(['inspectionStatus']) || (
        data.keys().hasAll(['packedBoxes', 'inspectedBoxes', 'acceptedBoxes', 'rejectedBoxes', 'reworkBoxes'])
        && data.inspectionStatus in ['awaiting_inspection', 'partially_accepted', 'accepted', 'rework', 'rejected']
        && data.inspectedBoxes >= 0
        && data.inspectedBoxes <= data.packedBoxes
        && data.acceptedBoxes >= 0
        && data.rejectedBoxes >= 0
        && data.reworkBoxes >= 0
        && data.acceptedBoxes + data.rejectedBoxes + data.reworkBoxes == data.inspectedBoxes
      );
    }

    function packingQualityCountersUnchanged(before, after) {
      return before.inspectionStatus == after.inspectionStatus
        && before.inspectedBoxes == after.inspectedBoxes
        && before.acceptedBoxes == after.acceptedBoxes
        && before.rejectedBoxes == after.rejectedBoxes
        && before.reworkBoxes == after.reworkBoxes
        && before.get('lastQualityEventId', '') == after.get('lastQualityEventId', '');
    }

    // ── Super Admin — full access to everything ──────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── System config (read-only for all signed-in users) ────────
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isSameOrg(resource.data.organizationId) && isOwnerOrManager() && hasAccess('team'))
      );
      allow create: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid
          ) ||
          isValidInvitationProfileWrite(userId)
        );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
        (
          isValidInvitationProfileWrite(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'organizationId', 'organizationName', 'industry', 'role', 'access', 'acceptedInviteId', 'updatedAt'])
        ) ||
        (
          isSameOrg(resource.data.organizationId)
          && isOwnerOrManager()
          && hasAccess('team')
          && canDelegateRoleAccess(request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt'])
        ) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      match /memberships/{membershipOrgId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.organizationId == membershipOrgId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == invitationDoc(request.resource.data.acceptedInviteId).role
          && request.resource.data.access == invitationDoc(request.resource.data.acceptedInviteId).access
          && invitationDoc(request.resource.data.acceptedInviteId).email == request.auth.token.email
          && invitationDoc(request.resource.data.acceptedInviteId).organizationId == membershipOrgId
          && invitationDoc(request.resource.data.acceptedInviteId).status == 'pending';
        allow update: if isSignedIn()
          && isSameOrg(membershipOrgId)
          && isOwnerOrManager()
          && hasAccess('team')
          && canDelegateRoleAccess(request.resource.data)
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt']);
        allow delete: if isSuperAdmin();
      }
    }

    // ── Organisations ────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSameOrg(orgId) || isSuperAdmin());
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.subscription.plan == 'free_trial'
        && request.resource.data.subscription.status == 'active';
      allow update: if isSignedIn() && (
        (isSameOrg(orgId) && (
          (isOwner()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name', 'industry', 'currency', 'address', 'phone', 'taxId',
                'onboardingStep', 'onboardingComplete', 'receiptSettings', 'settings', 'updatedAt'
              ])) ||
          (isManager()
            && hasAccess('settings')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'updatedAt']))
        )) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      match /locations/{locationId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /transfers/{transferId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /shifts/{shiftId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('team');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager() && hasAccess('team');
      }

      // ── Credits / Rewards ──────────────────────────────────────
      match /credits/{creditId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSuperAdmin();
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager() && hasAccess('team');
        allow create, update: if isSignedIn()
          && request.resource.data.organizationId == orgId
          && request.resource.data.uid == memberId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == invitationDoc(request.resource.data.acceptedInviteId).role
          && request.resource.data.access == invitationDoc(request.resource.data.acceptedInviteId).access
          && invitationDoc(request.resource.data.acceptedInviteId).email == request.auth.token.email
          && invitationDoc(request.resource.data.acceptedInviteId).organizationId == orgId
          && invitationDoc(request.resource.data.acceptedInviteId).status == 'pending';
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && isOwnerOrManager()
          && hasAccess('team')
          && canDelegateRoleAccess(request.resource.data)
          && resource.data.role in ['manager', 'worker']
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt']);
        allow delete: if isSuperAdmin() || (isSignedIn() && isSameOrg(orgId) && isOwner());
      }

      // ── Agric collections ──────────────────────────────────────
      // Expense intelligence
      match /expense_categories/{categoryId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('expenses') && isOwnerOrManager();
      }

      match /expense_budgets/{budgetId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('expenses') && isOwnerOrManager();
      }

      match /expenses/{expenseId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('expenses')
          && request.resource.data.submittedById == request.auth.uid
          && request.resource.data.amount > 0
          && (isOwnerOrManager() || request.resource.data.status == 'pending');
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('expenses')
          && isOwnerOrManager()
          && request.resource.data.amount > 0
          && request.resource.data.submittedById == resource.data.submittedById;
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      match /agric_inventory/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (
          hasAccess('agricStock') || hasAccess('agricReports') || hasAccess('agricRequests') ||
          hasAccess('agricUsage') || hasAccess('agricPlanner')
        );
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricStock');
        allow delete: if isSuperAdmin();
      }
      match /agric_usage/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricUsage') || hasAccess('agricReports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricUsage');
        allow update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricUsage');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricUsage') && isOwnerOrManager();
      }
      match /agric_requests/{id} {
        allow read: if isSignedIn()
          && isSameOrg(orgId)
          && hasAccess('agricRequests')
          && (resource.data.status != 'draft' || resource.data.requestedBy == request.auth.uid || isOwnerOrManager());
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricRequests')
          && request.resource.data.requestedBy == request.auth.uid
          && (
            request.resource.data.status == 'pending' ||
            (isOwnerOrManager() && request.resource.data.status == 'draft') ||
            (
              isOwnerOrManager()
              && request.resource.data.status == 'approved'
              && request.resource.data.approvedBy == request.auth.uid
            )
          );
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && (
            (
              hasAccess('agricRequests')
              && isOwnerOrManager()
              && resource.data.status in ['draft', 'pending']
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'approvedBy', 'approvedAt', 'rejectionReason', 'updatedAt'
              ])
            ) ||
            (
              hasAccess('agricRequests')
              && isOwnerOrManager()
              && resource.data.status == 'draft'
              && resource.data.requestedBy == request.auth.uid
              && request.resource.data.requestedBy == resource.data.requestedBy
              && request.resource.data.status in ['draft', 'pending', 'approved']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'farmZone', 'priority', 'items', 'status', 'note', 'requiredByDate',
                'approvedBy', 'approvedAt', 'updatedAt'
              ])
            ) ||
            (
              canFulfillStockRequests()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'items', 'dispatchedBy', 'dispatchedAt', 'lastDispatchedAt',
                'receivedBy', 'receivedAt', 'issueHistory', 'fulfillmentHistory', 'updatedAt'
              ])
            ) ||
            (
              request.auth.uid == resource.data.requestedBy
              && resource.data.status in ['partially_fulfilled', 'dispatched']
              && request.resource.data.status in ['partially_fulfilled', 'received']
              && request.resource.data.receivedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'items', 'receivedBy', 'receivedAt', 'fulfillmentHistory', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_equipment/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricEquipment') || hasAccess('agricReports'));
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricEquipment');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricEquipment') && isOwnerOrManager();
      }
      match /agric_plans/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPlanner') || hasAccess('agricReports'));
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPlanner');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPlanner') && isOwnerOrManager();
      }
      match /agric_packing/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && validPackingQualityState(request.resource.data);
        allow update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking')
          && validPackingQualityState(request.resource.data)
          && (
            isOwnerOrManager()
            || (
              request.resource.data.get('lastQualityEventId', '') != resource.data.get('lastQualityEventId', '')
              && request.resource.data.inspectorId == request.auth.uid
            )
          )
          && (
            (
              !('inspectionStatus' in resource.data)
              && !('inspectionStatus' in request.resource.data)
            )
            || (
              'inspectionStatus' in resource.data
              && (
                packingQualityCountersUnchanged(resource.data, request.resource.data)
                || (
                  request.resource.data.get('lastQualityEventId', '') != resource.data.get('lastQualityEventId', '')
                  && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing_inspections/$(request.resource.data.lastQualityEventId)).data.packingRecordId == id
                )
              )
            )
          )
          && (
            !('inspectionStatus' in resource.data)
            || resource.data.inspectedBoxes == 0
            || (
              request.resource.data.packageType == resource.data.packageType
              && request.resource.data.packageSize == resource.data.packageSize
              && request.resource.data.qualityGrade == resource.data.qualityGrade
              && request.resource.data.lotNumber == resource.data.lotNumber
              && request.resource.data.palletId == resource.data.palletId
              && request.resource.data.storageLocation == resource.data.storageLocation
            )
          );
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager()
          && 'inspectionStatus' in resource.data
          && resource.data.inspectedBoxes == 0
          && resource.data.acceptedBoxes == 0;
      }
      match /agric_packing_stations/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricPacking');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
      }
      match /agric_packing_plans/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
      }
      match /agric_packing_crews/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricPacking');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
      }
      match /agric_packing_transport/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricPacking');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
      }
      match /agric_packing_inspections/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking')
          && request.resource.data.inspectorId == request.auth.uid
          && request.resource.data.packingRecordId is string
          && request.resource.data.eventType in ['inspection', 'rework_resolution', 'correction']
          && request.resource.data.packedDelta is number
          && request.resource.data.inspectedDelta is number
          && request.resource.data.acceptedDelta is number
          && request.resource.data.rejectedDelta is number
          && request.resource.data.reworkDelta is number
          && (
            (
              request.resource.data.eventType == 'inspection'
              && request.resource.data.packedDelta == 0
              && request.resource.data.inspectedDelta > 0
              && request.resource.data.acceptedDelta >= 0
              && request.resource.data.rejectedDelta >= 0
              && request.resource.data.reworkDelta >= 0
              && request.resource.data.inspectedDelta == request.resource.data.acceptedDelta + request.resource.data.rejectedDelta + request.resource.data.reworkDelta
            )
            || (
              request.resource.data.eventType == 'rework_resolution'
              && request.resource.data.packedDelta == 0
              && request.resource.data.inspectedDelta == 0
              && request.resource.data.acceptedDelta >= 0
              && request.resource.data.rejectedDelta >= 0
              && request.resource.data.reworkDelta == -(request.resource.data.acceptedDelta + request.resource.data.rejectedDelta)
            )
            || (request.resource.data.eventType == 'correction' && isOwnerOrManager())
          )
          && (
            (request.resource.data.rejectedDelta <= 0 && request.resource.data.reworkDelta <= 0 && request.resource.data.eventType != 'correction')
            || (request.resource.data.reason is string && request.resource.data.reason.size() >= 3)
          )
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.lastQualityEventId == id
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.inspectorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.stationId == request.resource.data.stationId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.produce == request.resource.data.produce
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.packageType == request.resource.data.packageType
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.qualityGrade == request.resource.data.qualityGrade
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.lotNumber == request.resource.data.lotNumber
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.packedBoxes == get(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.packedBoxes + request.resource.data.packedDelta
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.inspectedBoxes == get(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.inspectedBoxes + request.resource.data.inspectedDelta
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.acceptedBoxes == get(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.acceptedBoxes + request.resource.data.acceptedDelta
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.rejectedBoxes == get(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.rejectedBoxes + request.resource.data.rejectedDelta
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.reworkBoxes == get(/databases/$(database)/documents/organizations/$(orgId)/agric_packing/$(request.resource.data.packingRecordId)).data.reworkBoxes + request.resource.data.reworkDelta;
        allow update, delete: if false;
      }
      match /agric_packing_quality_config/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricPacking');
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
        allow delete: if false;
      }
      match /agric_shipping/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking') && isOwnerOrManager();
      }
      match /agric_adjustments/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_alerts/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_deletion_log/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (isOwnerOrManager() || isSuperAdmin());
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && (
            isOwnerOrManager()
            || isSuperAdmin()
            || (
              hasAccess('agricSigatoka')
              && request.resource.data.performedBy == request.auth.uid
              && request.resource.data.action in ['sigatoka_archive', 'sigatoka_restore', 'sigatoka_permanent_delete']
              && (
                request.resource.data.action == 'sigatoka_restore'
                || (
                  request.resource.data.reason is string
                  && request.resource.data.reason.size() >= 5
                )
              )
            )
          );
        allow update, delete: if false;
      }
      match /agric_water_records/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricWeather');
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricWeather')
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricWeather')
          && request.resource.data.createdBy == resource.data.createdBy
          && (isOwnerOrManager() || request.auth.uid == resource.data.createdBy);
        allow delete: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricWeather')
          && (isOwnerOrManager() || request.auth.uid == resource.data.createdBy);
      }
      match /agric_livestock/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricLivestock');
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricLivestock');
        allow update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricLivestock');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricLivestock') && isOwnerOrManager();
      }
      match /agric_crop_plans/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricCrops');
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricCrops');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricCrops') && isOwnerOrManager();
      }
      match /agric_sigatoka_observations/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricSigatoka') || hasAccess('agricReports'));
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricSigatoka')
          && request.resource.data.observerId == request.auth.uid
          && request.resource.data.status in ['draft', 'submitted'];
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricSigatoka')
          && request.resource.data.observerId == resource.data.observerId
          && (
            (
              (isOwnerOrManager() || isSuperAdmin())
              && request.resource.data.status in ['draft', 'submitted', 'verified']
            ) ||
            (
              request.auth.uid == resource.data.observerId
              && resource.data.status in ['draft', 'submitted']
              && request.resource.data.status in ['draft', 'submitted']
            )
          );
        allow delete: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('agricSigatoka')
          && (
            isOwnerOrManager()
            || isSuperAdmin()
            || (
              request.auth.uid == resource.data.observerId
              && resource.data.status in ['draft', 'submitted']
            )
          );
      }
    }

    // ── Invitations ──────────────────────────────────────────────
    match /invitations/{inviteId} {
      allow create: if isSignedIn()
        && isSameOrg(request.resource.data.organizationId)
        && isOwnerOrManager()
        && hasAccess('team')
        && canDelegateRoleAccess(request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.role in ['manager', 'worker']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;
      allow get: if resource.data.status == 'pending' ||
        (isSignedIn() && (
          isSameOrg(resource.data.organizationId) ||
          resource.data.email == request.auth.token.email
        ));
      allow list: if isSignedIn() && isSameOrg(resource.data.organizationId);
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'acceptedByUid']);
      allow delete: if isSuperAdmin();
    }

    // ── Default deny (overridden by super admin catch-all above) ─
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
