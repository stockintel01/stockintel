rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// IntelliStock AI — Firestore Security Rules
//
// Principle of least privilege:
//   - Users can only read/write their own org's data
//   - Role hierarchy: owner > manager > worker
//   - Workers get read-only on inventory; no team/billing access
//   - All writes are validated for required fields
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function orgId() {
      return userDoc().organizationId;
    }

    function isOwner()   { return role() == 'owner';   }
    function isManager() { return role() == 'manager'; }
    function isWorker()  { return role() == 'worker';  }

    function isSameOrg(resourceOrgId) {
      return orgId() == resourceOrgId;
    }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can read their own profile; owners/managers can read org members
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSameOrg(resource.data.organizationId) && isOwnerOrManager()
      );
      // Users create/update their own profile only
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // Never hard-delete users
    }

    // ── Organizations ────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSignedIn() && isSameOrg(orgId);
      allow create: if isSignedIn(); // handled during signup flow
      allow update: if isSignedIn() && isSameOrg(orgId) && isOwner();
      allow delete: if false;

      // ── Inventory (core feature) ─────────────────────────────
      match /inventory/{itemId} {
        allow read: if isSignedIn() && isSameOrg(orgId);

        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && isOwnerOrManager()
          && request.resource.data.keys().hasAll(['name', 'sku', 'quantity', 'mrp', 'costPrice'])
          && request.resource.data.quantity >= 0
          && request.resource.data.mrp >= 0;

        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && (
            isOwnerOrManager()
            // Workers can only adjust quantity (e.g. during POS sale)
            || (isWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']))
          )
          && (
            !request.resource.data.keys().hasAll(['quantity'])
            || request.resource.data.quantity >= 0
          );

        allow delete: if false; // Use soft-delete (deletedAt field) instead
      }

      // ── Credits / Rewards ────────────────────────────────────
      match /credits/{creditId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if false; // Created by Cloud Functions only
        allow update: if isSignedIn() && isSameOrg(orgId) && isOwner()
          && request.resource.data.status == 'used'
          && resource.data.status == 'available';
        allow delete: if false;
      }
    }

    // ── Invitations ──────────────────────────────────────────────
    match /invitations/{inviteId} {
      // Owners/managers can create invites for their org
      allow create: if isSignedIn()
        && isOwnerOrManager()
        && request.resource.data.organizationId == orgId();

      // Anyone signed in can read their own invite (matched by email during signup)
      allow read: if isSignedIn();

      // Only owners/managers can update (e.g. cancel an invite)
      allow update: if isSignedIn() && isOwnerOrManager()
        && isSameOrg(resource.data.organizationId);

      allow delete: if false;
    }

    // ── Block everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
