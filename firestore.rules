rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// StockIntel — Firestore Security Rules
//
// Role hierarchy: super_admin > owner > manager > worker
// Approved super admin accounts have full read/write.
// All other access is org-scoped and role-gated.
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'mawuklegodson@gmail.com',
          'enochapafloe@gmail.com',
          'stockintel01@gmail.com'
        ];
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function orgId() {
      return userDoc().organizationId;
    }

    function isOwner()   { return role() == 'owner';   }
    function isManager() { return role() == 'manager'; }
    function isWorker()  { return role() == 'worker';  }

    function isOwnerOrManager() {
      return isOwner() || isManager();
    }

    function hasAccess(key) {
      return isSuperAdmin() || isOwner() ||
        (isManager() && !userDoc().keys().hasAny(['access'])) ||
        (userDoc().keys().hasAny(['access']) && userDoc().access.hasAny([key]));
    }

    function isSameOrg(resourceOrgId) {
      return orgId() == resourceOrgId;
    }

    function invitationDoc(inviteId) {
      return get(/databases/$(database)/documents/invitations/$(inviteId)).data;
    }

    function isValidInvitationProfileWrite(userId) {
      let invite = invitationDoc(request.resource.data.acceptedInviteId);
      return request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.organizationId == invite.organizationId
        && request.resource.data.role in ['manager', 'worker']
        && invite.email == request.auth.token.email
        && invite.status == 'pending';
    }

    function hasActiveSubscription(resourceOrgId) {
      let subscription = get(/databases/$(database)/documents/organizations/$(resourceOrgId)).data.subscription;
      return isSuperAdmin() || (
        subscription.status == 'active' &&
        (
          (subscription.plan == 'free_trial' && subscription.trialEndsAt > request.time) ||
          (subscription.plan != 'free_trial' && (!('currentPeriodEnd' in subscription) || subscription.currentPeriodEnd > request.time))
        )
      );
    }

    // ── Super Admin — full access to everything ──────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── System config (read-only for all signed-in users) ────────
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Global patients collection (cross-pharmacy) ──────────────
    match /patients/{patientId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isSameOrg(resource.data.organizationId) && isOwnerOrManager())
      );
      allow create: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid
          ) ||
          isValidInvitationProfileWrite(userId)
        );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
        (
          isValidInvitationProfileWrite(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'organizationId', 'organizationName', 'industry', 'role', 'access', 'acceptedInviteId', 'updatedAt'])
        ) ||
        (
          isSameOrg(resource.data.organizationId)
          && isOwnerOrManager()
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt'])
        ) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      match /memberships/{membershipOrgId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.organizationId == membershipOrgId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['manager', 'worker']
          && invitationDoc(request.resource.data.acceptedInviteId).email == request.auth.token.email
          && invitationDoc(request.resource.data.acceptedInviteId).organizationId == membershipOrgId
          && invitationDoc(request.resource.data.acceptedInviteId).status == 'pending';
        allow update: if isSignedIn()
          && isSameOrg(membershipOrgId)
          && isOwnerOrManager()
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt']);
        allow delete: if isSuperAdmin();
      }
    }

    // ── Organisations ────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSameOrg(orgId) || isSuperAdmin());
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.subscription.plan == 'free_trial'
        && request.resource.data.subscription.status == 'active';
      allow update: if isSignedIn() && (
        (isSameOrg(orgId) && isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name', 'industry', 'currency', 'address', 'phone', 'taxId',
              'onboardingStep', 'onboardingComplete', 'receiptSettings', 'settings', 'updatedAt'
            ])) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      // ── Inventory ─────────────────────────────────────────────
      match /inventory/{itemId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('inventory') || hasAccess('sales') || hasAccess('reports'));
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('inventory')
          && request.resource.data.keys().hasAll(['name', 'sku', 'quantity', 'mrp', 'costPrice'])
          && request.resource.data.quantity >= 0
          && request.resource.data.mrp >= 0;
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && (
            hasAccess('inventory') ||
            (isWorker() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']))
          )
          && (!request.resource.data.keys().hasAll(['quantity']) || request.resource.data.quantity >= 0);
        allow delete: if isSuperAdmin();
      }

      // ── Prescriptions ─────────────────────────────────────────
      match /prescriptions/{rxId} {
        allow read, write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('prescriptions');
      }

      // ── Customers ─────────────────────────────────────────────
      match /customers/{custId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('customers');
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('customers');
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      // ── Sales ─────────────────────────────────────────────────
      match /sales/{saleId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('sales') || hasAccess('reports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('sales');
        allow update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('sales');
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /locations/{locationId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /transfers/{transferId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwner();
      }

      match /shifts/{shiftId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      // ── Consultations ─────────────────────────────────────────
      match /consultations/{cId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('consultation');
        allow write: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('consultation');
      }

      match /patients/{patientId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('patients');
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('patients');
        allow delete: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager();
      }

      // ── Credits / Rewards ──────────────────────────────────────
      match /credits/{creditId} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSuperAdmin();
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager();
        allow create, update: if isSignedIn()
          && request.resource.data.organizationId == orgId
          && request.resource.data.uid == memberId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['manager', 'worker']
          && invitationDoc(request.resource.data.acceptedInviteId).email == request.auth.token.email
          && invitationDoc(request.resource.data.acceptedInviteId).organizationId == orgId
          && invitationDoc(request.resource.data.acceptedInviteId).status == 'pending';
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && isOwnerOrManager()
          && resource.data.role in ['manager', 'worker']
          && request.resource.data.role in ['manager', 'worker']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'access', 'updatedAt']);
        allow delete: if isSuperAdmin() || (isSignedIn() && isSameOrg(orgId) && isOwner());
      }

      // ── Agric collections ──────────────────────────────────────
      // Expense intelligence
      match /expense_categories/{categoryId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('expenses') && isOwnerOrManager();
      }

      match /expense_budgets/{budgetId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('expenses') && isOwnerOrManager();
      }

      match /expenses/{expenseId} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('expenses');
        allow create: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('expenses')
          && request.resource.data.submittedById == request.auth.uid
          && request.resource.data.amount > 0
          && (isOwnerOrManager() || request.resource.data.status == 'pending');
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && hasAccess('expenses')
          && isOwnerOrManager()
          && request.resource.data.amount > 0
          && request.resource.data.submittedById == resource.data.submittedById;
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }

      match /agric_inventory/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricStock') || hasAccess('agricReports'));
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricStock');
        allow delete: if isSuperAdmin();
      }
      match /agric_usage/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricUsage') || hasAccess('agricReports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricUsage');
        allow update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricUsage');
      }
      match /agric_requests/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricRequests');
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricRequests');
        allow update: if isSignedIn()
          && isSameOrg(orgId)
          && hasActiveSubscription(orgId)
          && (
            hasAccess('agricRequests') ||
            (
              request.auth.uid == resource.data.requestedBy
              && resource.data.status == 'dispatched'
              && request.resource.data.status == 'received'
              && request.resource.data.receivedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedBy', 'receivedAt', 'updatedAt'])
            )
          );
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricRequests');
      }
      match /agric_equipment/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricEquipment') || hasAccess('agricReports'));
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricEquipment');
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricEquipment');
      }
      match /agric_plans/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPlanner') || hasAccess('agricReports'));
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPlanner');
      }
      match /agric_packing/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking');
        allow update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking');
      }
      match /agric_packing_stations/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricPacking');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_shipping/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && (hasAccess('agricPacking') || hasAccess('agricReports'));
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricPacking');
      }
      match /agric_adjustments/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_alerts/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId);
        allow create, update: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId);
        allow delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
      }
      match /agric_deletion_log/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && isOwnerOrManager();
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && isOwnerOrManager();
        allow update, delete: if false;
      }
      match /agric_livestock/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricLivestock');
        allow create: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricLivestock');
        allow update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricLivestock');
      }
      match /agric_crop_plans/{id} {
        allow read: if isSignedIn() && isSameOrg(orgId) && hasAccess('agricCrops');
        allow create, update, delete: if isSignedIn() && isSameOrg(orgId) && hasActiveSubscription(orgId) && hasAccess('agricCrops');
      }
    }

    // ── Invitations ──────────────────────────────────────────────
    match /invitations/{inviteId} {
      allow create: if isSignedIn()
        && isSameOrg(request.resource.data.organizationId)
        && isOwnerOrManager()
        && request.resource.data.email is string
        && request.resource.data.role in ['manager', 'worker']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;
      allow get: if resource.data.status == 'pending' ||
        (isSignedIn() && (
          isSameOrg(resource.data.organizationId) ||
          resource.data.email == request.auth.token.email
        ));
      allow list: if isSignedIn() && isSameOrg(resource.data.organizationId);
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'acceptedByUid']);
      allow delete: if isSuperAdmin();
    }

    // ── Default deny (overridden by super admin catch-all above) ─
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
