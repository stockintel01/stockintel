{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/comms/webhooks/whatsapp/route.ts": {
      "maxDuration": 15
    },
    "app/api/comms/cron/dispatch/route.ts": {
      "maxDuration": 60
    },
    "app/api/comms/cron/scan/route.ts": {
      "maxDuration": 60
    },
    "app/api/supabase/keepalive/route.ts": {
      "maxDuration": 15
    },
    "app/api/webhooks/stripe/route.ts": {
      "maxDuration": 10
    },
    "app/api/webhooks/paystack/route.ts": {
      "maxDuration": 15
    },
    "app/api/payments/paystack/callback/route.ts": {
      "maxDuration": 15
    },
    "app/api/checkout/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/supabase/keepalive",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=self, microphone=(), geolocation=self" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "trailingSlash": false
}
