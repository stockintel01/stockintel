# ─────────────────────────────────────────────────────────────────────────────
# IntelliStock AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin (server-only service account values)
# Recommended on Vercel: base64 encode the complete service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative: provide the raw JSON as one environment value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or configure the three individual values below.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -- Data backend / Supabase migration ---------------------------------------
# Keep Firebase active until auth and data migration verification is complete.
NEXT_PUBLIC_DATA_BACKEND=firebase
NEXT_PUBLIC_SUPABASE_URL=https://urhngoeszqpaeripatnk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PROJECT_REF=urhngoeszqpaeripatnk

# -- Subscription payments --------------------------------------------------
PAYMENT_PROVIDER=paystack

# Paystack keys and monthly GHS plans. Keep the secret key server-only.
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PLAN_CODE_PRO=PLN_...
PAYSTACK_PLAN_CODE_ENTERPRISE=PLN_...

# Optional Stripe fallback
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these in Stripe Dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRODUCT_PRO=prod_...
STRIPE_PRODUCT_ENTERPRISE=prod_...

# ── AI Provider (choose OpenAI, Gemini, Anthropic, or auto) ─────────────────
AI_PROVIDER=auto
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Server-only. Meta App Dashboard → WhatsApp → API Setup. Use a System User token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The sending number in international format, shown to people connecting WhatsApp.
WHATSAPP_DISPLAY_PHONE_NUMBER=+233...
# Meta App Dashboard → App settings → Basic → App secret. Verifies webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string. Enter the same value when subscribing the webhook in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Leave unset in production. Only a staging or test run points this at a stub.
WHATSAPP_GRAPH_BASE_URL=
# Bearer token the scheduler sends to /api/comms/cron/*. Vercel Cron sends it automatically.
CRON_SECRET=
# observe counts WhatsApp messages against plan limits; enforce also blocks sends over the limit.
COMMS_QUOTA_MODE=observe

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public merchant details required on customer-facing payment information.
# Replace every placeholder with the registered business details before launch.
NEXT_PUBLIC_MERCHANT_LEGAL_NAME=Your registered business name
NEXT_PUBLIC_MERCHANT_TRADING_NAME=StockIntel Agri
NEXT_PUBLIC_MERCHANT_ADDRESS=Your complete business address, Ghana
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+233...
