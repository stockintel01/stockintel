# ─────────────────────────────────────────────────────────────────────────────
# IntelliStock AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Stripe ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these in Stripe Dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_...

# ── Anthropic (AI Consultation) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio (WhatsApp / SMS Alerts) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# For SMS — a purchased Twilio phone number
TWILIO_FROM_NUMBER=+1...
# For WhatsApp — Twilio sandbox or approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Shared secret for the /api/alerts/low-stock endpoint
ALERT_WEBHOOK_SECRET=generate_a_random_32char_secret_here
NEXT_PUBLIC_ALERT_SECRET=same_as_above

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
