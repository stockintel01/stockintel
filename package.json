{
  "name": "intellistock-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:sigatoka": "node --no-warnings --experimental-strip-types scripts/verify-sigatoka.mjs",
    "test:packing": "node --no-warnings --experimental-strip-types scripts/verify-packing.mjs",
    "test:water": "node --no-warnings --experimental-strip-types scripts/verify-water-balance.mjs",
    "test:receipts": "node --no-warnings --experimental-strip-types scripts/verify-sales-receipts.mjs",
    "test:supabase": "node scripts/verify-supabase-foundation.mjs",
    "test:comms": "node --no-warnings --experimental-strip-types scripts/verify-comms.mjs",
    "test:migration": "node --no-warnings --experimental-strip-types --import ./scripts/ts-path-resolver.mjs scripts/verify-migration-mapping.mjs",
    "test:branding": "node --no-warnings --experimental-strip-types scripts/verify-app-branding.mjs",
    "test:expenses": "node --no-warnings --experimental-strip-types --import ./scripts/ts-path-resolver.mjs scripts/verify-expenses.mjs",
    "test:auth": "node --no-warnings --experimental-strip-types --import ./scripts/ts-path-resolver.mjs scripts/verify-auth.mjs",
    "test:onboarding": "node --no-warnings --experimental-strip-types --import ./scripts/ts-path-resolver.mjs scripts/verify-onboarding.mjs",
    "test:navigation": "node --no-warnings --experimental-strip-types --import ./scripts/ts-path-resolver.mjs scripts/verify-dashboard-routing.mjs",
    "test:comms-integration": "node scripts/verify-comms-integration.mjs",
    "check:env": "node scripts/check-env.mjs",
    "migrate:export": "node --no-warnings --experimental-strip-types scripts/export-firebase.mjs",
    "migrate:import": "node --no-warnings --experimental-strip-types scripts/import-supabase.mjs",
    "db:link": "supabase link --project-ref urhngoeszqpaeripatnk",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "verify": "npm run typecheck && npm run test:sigatoka && npm run test:packing && npm run test:water && npm run test:receipts && npm run test:supabase && npm run test:comms && npm run test:migration && npm run test:branding && npm run test:expenses && npm run test:auth && npm run test:onboarding && npm run test:navigation && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.8.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "postcss": "^8.5.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "2.116.0",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
